---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout 
  title="THE WEDDING BLOUSE by Kaaru - Premium Bridal Designs"
  description="Every marriage begins with trust. Every bride begins with us. Browse our collections: Regular, Designer, Manthram, Vaibhavam, Mahotsavam, Kurti, and Kids.">

  <main id="home" class="scroll-smooth">

    <!-- ═══════════════════════════════════════════════
         HERO — Full-screen editorial split layout
    ════════════════════════════════════════════════ -->
    <section class="relative min-h-screen flex flex-col md:flex-row overflow-hidden hero-curtain-container">

      <!-- Left: Brand Statement Panel -->
      <div class="relative z-10 flex flex-col justify-center bg-[#e1a730] text-[#5A0007]
                  w-full md:w-[60%] px-10 md:px-16 py-24 md:py-0 shrink-0">

        <!-- Decorative corner ornaments with delayed ambient gold sheen -->
        <div class="absolute top-8 left-8 w-16 h-16 border-t-2 border-l-2 border-[#5A0007] opacity-40 gold-sheen-target"></div>
        <div class="absolute bottom-8 right-8 w-16 h-16 border-b-2 border-r-2 border-[#5A0007] opacity-40 gold-sheen-target"></div>

        <!-- Headline (Curtain Rise Stage 1) -->
        <h1 class="heading text-5xl md:text-6xl lg:text-7xl font-bold leading-[1.05] mb-6 text-[#5A0007] curtain-headline">
          The<br/>
          Wedding Blouse<br/>
          <em class="not-italic text-[#7E1215]">by Kaaru.</em>
        </h1>

        <!-- Divider rule with Curtain Rise expansion -->
        <div class="flex items-center gap-4 mb-6 curtain-divider-group">
          <div class="h-px bg-[#5A0007] curtain-divider-line opacity-60"></div>
          <div class="w-1.5 h-1.5 rounded-full bg-[#5A0007] curtain-divider-dot"></div>
          <div class="h-px bg-[#5A0007] curtain-divider-line opacity-60"></div>
        </div>

        <!-- Tagline (Curtain Rise Stage 2) -->
        <p class="text-[#5A0007]/90 text-base md:text-lg leading-relaxed max-w-xs mb-10 font-medium curtain-subtext">
          Every marriage begins with trust.<br/>Every bride begins with us.
        </p>

        <!-- CTA Buttons (Curtain Rise Stage 3 + Striking Light Beam on Button) -->
        <div class="flex flex-col sm:flex-row gap-4 curtain-actions">
          <a href="/gallery"
            class="gold-sheen-button relative overflow-hidden inline-flex items-center justify-center gap-2 bg-[#5A0007] text-[#e1a730]
                   font-bold text-sm tracking-wider uppercase px-8 py-4 shadow-lg">
            <span class="relative z-10 flex items-center gap-2">
              Explore Collections
              <i class="fas fa-arrow-right text-xs"></i>
            </span>
          </a>
          <a href="#about"
            class="inline-flex items-center justify-center gap-2 border-2 border-[#5A0007] text-[#5A0007]
                   font-semibold text-sm tracking-wider uppercase px-8 py-4
                   hover:bg-[#5A0007] hover:text-[#e1a730] transition-all duration-300">
            Our Story
          </a>
        </div>

        <!-- Floating stat strip (Curtain Rise Stage 4) -->
        <div class="mt-16 flex gap-10 curtain-stats">
          <div>
            <p class="heading text-3xl font-bold text-[#5A0007]">10+</p>
            <p class="text-[#5A0007]/75 text-xs tracking-wider uppercase mt-1 font-semibold">Years of Craft</p>
          </div>
          <div class="w-px bg-[#5A0007]/25"></div>
          <div>
            <p class="heading text-3xl font-bold text-[#5A0007]">8</p>
            <p class="text-[#5A0007]/75 text-xs tracking-wider uppercase mt-1 font-semibold">Collections</p>
          </div>
          <div class="w-px bg-[#5A0007]/25"></div>
          <div>
            <p class="heading text-3xl font-bold text-[#5A0007]">∞</p>
            <p class="text-[#5A0007]/75 text-xs tracking-wider uppercase mt-1 font-semibold">Happy Brides</p>
          </div>
        </div>
      </div>

      <!-- Right: Single Hero Image Panel (Curtain Rise Stage 1) -->
      <div class="relative w-full md:w-[40%] min-h-[50vh] md:min-h-0 bg-[#e1a730] overflow-hidden curtain-image-panel">
        <img src="/assets/kaaru.jpeg" alt="Kaaru Bridal Blouse Couture"
          class="w-full h-full object-cover object-center md:object-top block" />
        <!-- Subtle border accent -->
        <div class="absolute inset-0 border-[3px] border-[#5A0007]/20 pointer-events-none gold-sheen-target"></div>
      </div>

    </section>
    <!-- ═══════════════════════════════════════════════
         COLLECTIONS — 7-card grid with Editorial Unveil
    ════════════════════════════════════════════════ -->
    <section class="py-12 md:py-20 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12 editorial-reveal">
          <span class="text-brand-gold font-semibold text-sm tracking-widest uppercase">Collections</span>
          <h2 class="text-3xl md:text-5xl heading brand-maroon font-bold mt-3">Browse by Category</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

          <a href="/gallery?category=regular"
            style="--reveal-index: 0"
            class="editorial-reveal category-card block cursor-pointer rounded-xl overflow-hidden bg-brand-cream p-8 text-center shadow-premium">
            <div class="mb-4 flex justify-center items-center h-28">
              <img src="/assets/logo_transparent.png" alt="Regular Logo" class="h-28 w-auto object-contain" />
            </div>
            <h3 class="heading text-2xl font-bold brand-maroon mb-2">Regular</h3>
            <p class="text-gray-600 mb-4 text-sm">Timeless everyday elegance &amp; classic cuts</p>
            <span class="text-brand-maroon font-semibold text-sm inline-block">
              Explore <span class="card-arrow ml-1">→</span>
            </span>
          </a>

          <a href="/gallery?category=designer"
            style="--reveal-index: 1"
            class="editorial-reveal category-card block cursor-pointer rounded-xl overflow-hidden bg-brand-cream p-8 text-center shadow-premium">
            <div class="mb-4 flex justify-center items-center h-28">
              <img src="/assets/logo_transparent.png" alt="Designer Logo" class="h-28 w-auto object-contain" />
            </div>
            <h3 class="heading text-2xl font-bold brand-maroon mb-2">Designer</h3>
            <p class="text-gray-600 mb-4 text-sm">Chic, Contemporary &amp; Custom Stitched blouses</p>
            <span class="text-brand-maroon font-semibold text-sm inline-block">
              Explore <span class="card-arrow ml-1">→</span>
            </span>
          </a>

          <a href="/gallery?category=manthram"
            style="--reveal-index: 2"
            class="editorial-reveal category-card block cursor-pointer rounded-xl overflow-hidden bg-brand-cream p-8 text-center shadow-premium">
            <div class="mb-4 flex justify-center items-center h-28">
              <img src="/assets/logo_transparent.png" alt="Manthram Logo" class="h-28 w-auto object-contain" />
            </div>
            <h3 class="heading text-2xl font-bold brand-maroon mb-2">Manthram</h3>
            <p class="text-gray-600 mb-4 text-sm">Soft, elegant styles defining grace</p>
            <span class="text-brand-maroon font-semibold text-sm inline-block">
              Explore <span class="card-arrow ml-1">→</span>
            </span>
          </a>

          <a href="/gallery?category=vaibhavam"
            style="--reveal-index: 3"
            class="editorial-reveal category-card block cursor-pointer rounded-xl overflow-hidden bg-brand-cream p-8 text-center shadow-premium">
            <div class="mb-4 flex justify-center items-center h-28">
              <img src="/assets/logo_transparent.png" alt="Vaibhavam Logo" class="h-28 w-auto object-contain" />
            </div>
            <h3 class="heading text-2xl font-bold brand-maroon mb-2">Vaibhavam</h3>
            <p class="text-gray-600 mb-4 text-sm">Splendour with intricate handwork</p>
            <span class="text-brand-maroon font-semibold text-sm inline-block">
              Explore <span class="card-arrow ml-1">→</span>
            </span>
          </a>

          <a href="/gallery?category=mahotsavam"
            style="--reveal-index: 4"
            class="editorial-reveal category-card block cursor-pointer rounded-xl overflow-hidden bg-brand-cream p-8 text-center shadow-premium">
            <div class="mb-4 flex justify-center items-center h-28">
              <img src="/assets/logo_transparent.png" alt="Mahotsavam Logo" class="h-28 w-auto object-contain" />
            </div>
            <h3 class="heading text-2xl font-bold brand-maroon mb-2">Mahotsavam</h3>
            <p class="text-gray-600 mb-4 text-sm">Grand celebration, richest designs</p>
            <span class="text-brand-maroon font-semibold text-sm inline-block">
              Explore <span class="card-arrow ml-1">→</span>
            </span>
          </a>

          <a href="/gallery?category=kurti"
            style="--reveal-index: 5"
            class="editorial-reveal category-card block cursor-pointer rounded-xl overflow-hidden bg-brand-cream p-8 text-center shadow-premium">
            <div class="mb-4 flex justify-center items-center h-28">
              <img src="/assets/logo_transparent.png" alt="Kurti Logo" class="h-28 w-auto object-contain" />
            </div>
            <h3 class="heading text-2xl font-bold brand-maroon mb-2">Kurti</h3>
            <p class="text-gray-600 mb-4 text-sm">Modern silhouettes &amp; tailored festive kurtis</p>
            <span class="text-brand-maroon font-semibold text-sm inline-block">
              Explore <span class="card-arrow ml-1">→</span>
            </span>
          </a>

          <a href="/gallery?category=halfsaree"
            style="--reveal-index: 6"
            class="editorial-reveal category-card block cursor-pointer rounded-xl overflow-hidden bg-brand-cream p-8 text-center shadow-premium">
            <div class="mb-4 flex justify-center items-center h-28">
              <img src="/assets/logo_transparent.png" alt="Halfsaree Logo" class="h-28 w-auto object-contain" />
            </div>
            <h3 class="heading text-2xl font-bold brand-maroon mb-2">Halfsaree</h3>
            <p class="text-gray-600 mb-4 text-sm">Graceful drapes &amp; exquisite traditional ensembles</p>
            <span class="text-brand-maroon font-semibold text-sm inline-block">
              Explore <span class="card-arrow ml-1">→</span>
            </span>
          </a>

          <a href="/gallery?category=kids"
            style="--reveal-index: 7"
            class="editorial-reveal category-card block cursor-pointer rounded-xl overflow-hidden bg-brand-cream p-8 text-center shadow-premium">
            <div class="mb-4 flex justify-center items-center h-28">
              <img src="/assets/logo_transparent.png" alt="Kids Logo" class="h-28 w-auto object-contain" />
            </div>
            <h3 class="heading text-2xl font-bold brand-maroon mb-2">Kids</h3>
            <p class="text-gray-600 mb-4 text-sm">Charming traditional attire for little ones</p>
            <span class="text-brand-maroon font-semibold text-sm inline-block">
              Explore <span class="card-arrow ml-1">→</span>
            </span>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         BRAND PROMISE — Full-width dark band
    ════════════════════════════════════════════════ -->
    <section class="relative py-20 md:py-28 overflow-hidden bg-[#1a0000]">
      <!-- Background motif -->
      <div class="absolute inset-0 opacity-[0.06]">
        <svg width="100%" height="100%" viewBox="0 0 600 300" preserveAspectRatio="xMidYMid slice">
          <defs>
            <pattern id="brocade" x="0" y="0" width="60" height="60" patternUnits="userSpaceOnUse">
              <rect x="0" y="0" width="60" height="60" fill="none"/>
              <path d="M30 5 L55 30 L30 55 L5 30 Z" fill="none" stroke="#D4AF37" stroke-width="1"/>
              <circle cx="30" cy="30" r="6" fill="none" stroke="#D4AF37" stroke-width="1"/>
            </pattern>
          </defs>
          <rect width="600" height="300" fill="url(#brocade)"/>
        </svg>
      </div>

      <div class="relative z-10 max-w-5xl mx-auto px-8 text-center editorial-reveal">
        <div class="flex justify-center mb-8">
          <div class="w-20 h-px bg-[#D4AF37]"></div>
          <div class="mx-4 text-[#D4AF37] text-xs tracking-[0.4em] uppercase font-semibold self-center">Our Promise</div>
          <div class="w-20 h-px bg-[#D4AF37]"></div>
        </div>
        <blockquote class="heading text-3xl md:text-5xl lg:text-6xl font-bold text-white leading-snug mb-10">
          "Every blouse we craft is<br/>
          <span class="text-[#D4AF37]">not just worn, it is remembered."</span>
        </blockquote>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-8 mt-16 text-left">
          <div style="--reveal-index: 0" class="editorial-reveal flex gap-4 items-start">
            <div class="w-10 h-10 rounded-full bg-[#D4AF37]/10 border border-[#D4AF37]/30 flex items-center justify-center shrink-0 mt-1">
              <i class="fas fa-hand-holding-heart text-[#D4AF37] text-sm"></i>
            </div>
            <div>
              <h4 class="text-white font-bold text-sm tracking-wide mb-1">Personal Consultation</h4>
              <p class="text-white/50 text-xs leading-relaxed">We sit with every bride to understand her story, style, and vision.</p>
            </div>
          </div>
          <div style="--reveal-index: 1" class="editorial-reveal flex gap-4 items-start">
            <div class="w-10 h-10 rounded-full bg-[#D4AF37]/10 border border-[#D4AF37]/30 flex items-center justify-center shrink-0 mt-1">
              <i class="fas fa-pencil-ruler text-[#D4AF37] text-sm"></i>
            </div>
            <div>
              <h4 class="text-white font-bold text-sm tracking-wide mb-1">Bespoke Design</h4>
              <p class="text-white/50 text-xs leading-relaxed">Every blouse is an original — never a template, always a masterpiece.</p>
            </div>
          </div>
          <div style="--reveal-index: 2" class="editorial-reveal flex gap-4 items-start">
            <div class="w-10 h-10 rounded-full bg-[#D4AF37]/10 border border-[#D4AF37]/30 flex items-center justify-center shrink-0 mt-1">
              <i class="fas fa-gem text-[#D4AF37] text-sm"></i>
            </div>
            <div>
              <h4 class="text-white font-bold text-sm tracking-wide mb-1">Heirloom Quality</h4>
              <p class="text-white/50 text-xs leading-relaxed">Craftsmanship so refined, it passes from one generation to the next.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         INSTAGRAM GRID — Social proof editorial strip
    ════════════════════════════════════════════════ -->
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 md:px-10">
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 editorial-reveal">
          <div>
            <div class="flex items-center gap-2 mb-3">
              <i class="fab fa-instagram text-[#800000] text-lg"></i>
              <span class="text-[#D4AF37] text-xs tracking-[0.3em] uppercase font-semibold">@the.wedding.blouse</span>
            </div>
            <h2 class="heading text-3xl md:text-5xl brand-maroon font-bold">Follow Our Story</h2>
          </div>
          <a href="https://www.instagram.com/the.wedding.blouse/" target="_blank" rel="noopener noreferrer"
            class="mt-6 md:mt-0 inline-flex items-center gap-2 text-sm font-semibold tracking-wider uppercase text-[#800000]
                   border-b-2 border-[#D4AF37] pb-1 hover:text-[#D4AF37] transition-colors self-end">
            Open Instagram
            <i class="fab fa-instagram text-xs"></i>
          </a>
        </div>

        <!-- Instagram mosaic: 5 tiles with varying sizes, all linking directly to Instagram -->
        <div class="grid grid-cols-4 grid-rows-2 gap-2 md:gap-3 h-[400px] md:h-[500px] editorial-reveal">
          <!-- Large tile left -->
          <a href="https://www.instagram.com/the.wedding.blouse/" target="_blank" rel="noopener noreferrer"
            class="col-span-2 row-span-2 instafeed-item bg-[#800000]/10 rounded-sm overflow-hidden block relative group">
            <div class="w-full h-full bg-gradient-to-br from-[#800000]/20 to-[#e1a730]/20 relative">
              <div class="absolute inset-0 flex items-center justify-center opacity-30">
                <img src="/assets/logo_transparent.png" alt="" class="h-24 object-contain"/>
              </div>
              <div class="instafeed-overlay">
                <div class="text-center text-white">
                  <i class="fab fa-instagram text-3xl mb-2 block group-hover:scale-110 transition-transform duration-300"></i>
                  <p class="text-xs font-semibold">@the.wedding.blouse</p>
                </div>
              </div>
            </div>
          </a>

          <!-- Top right tile 1 -->
          <a href="https://www.instagram.com/the.wedding.blouse/" target="_blank" rel="noopener noreferrer"
            class="col-span-1 instafeed-item bg-[#e1a730]/30 rounded-sm overflow-hidden block relative group">
            <div class="w-full h-full flex items-center justify-center relative">
              <div class="instafeed-overlay rounded-sm">
                <i class="fab fa-instagram text-white text-xl group-hover:scale-110 transition-transform duration-300"></i>
              </div>
            </div>
          </a>

          <!-- Top right tile 2 -->
          <a href="https://www.instagram.com/the.wedding.blouse/" target="_blank" rel="noopener noreferrer"
            class="col-span-1 instafeed-item bg-[#800000]/20 rounded-sm overflow-hidden block relative group">
            <div class="w-full h-full flex items-center justify-center relative">
              <div class="instafeed-overlay rounded-sm">
                <i class="fab fa-instagram text-white text-xl group-hover:scale-110 transition-transform duration-300"></i>
              </div>
            </div>
          </a>

          <!-- Bottom right tile -->
          <a href="https://www.instagram.com/the.wedding.blouse/" target="_blank" rel="noopener noreferrer"
            class="col-span-2 instafeed-item bg-[#D4AF37]/20 rounded-sm overflow-hidden block relative group">
            <div class="w-full h-full flex items-center justify-center relative">
              <p class="text-[#800000]/30 heading text-2xl font-bold italic select-none">"Every stitch, a story"</p>
              <div class="instafeed-overlay rounded-sm">
                <i class="fab fa-instagram text-white text-xl group-hover:scale-110 transition-transform duration-300"></i>
              </div>
            </div>
          </a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         TESTIMONIALS — Premium horizontal cards
    ════════════════════════════════════════════════ -->
    <section class="py-12 md:py-20 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <span class="text-xs md:text-sm tracking-[0.25em] uppercase font-bold text-gray-800">Loved by Clients</span>
          <h2 class="heading text-3xl md:text-5xl text-[#5A0007] font-bold mt-3 mb-3">What Our Brides Say</h2>
          <p class="text-gray-600 text-sm md:text-base">Real stories from real celebrations</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <!-- Testimonial 1 -->
          <div class="bg-[#e1a730] p-8 md:p-10 rounded-2xl flex flex-col justify-between shadow-sm">
            <div>
              <div class="flex gap-1.5 text-black text-sm mb-6">
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
              </div>
              <p class="text-gray-900 text-sm md:text-base leading-relaxed italic mb-8">
                "The craftsmanship is impeccable. I felt like a queen on my wedding day. Every detail was perfect!"
              </p>
            </div>
            <div>
              <p class="font-bold text-gray-900 text-sm md:text-base tracking-wide">- Priyadharshini</p>
            </div>
          </div>

          <!-- Testimonial 2 -->
          <div class="bg-[#e1a730] p-8 md:p-10 rounded-2xl flex flex-col justify-between shadow-sm">
            <div>
              <div class="flex gap-1.5 text-black text-sm mb-6">
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
              </div>
              <p class="text-gray-900 text-sm md:text-base leading-relaxed italic mb-8">
                "From first consultation to wearing the blouse, my wife's experience was seamless. The quality is unmatched."
              </p>
            </div>
            <div>
              <p class="font-bold text-gray-900 text-sm md:text-base tracking-wide">- Krishnaa</p>
            </div>
          </div>

          <!-- Testimonial 3 -->
          <div class="bg-[#e1a730] p-8 md:p-10 rounded-2xl flex flex-col justify-between shadow-sm">
            <div>
              <div class="flex gap-1.5 text-black text-sm mb-6">
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
                <i class="fas fa-star"></i>
              </div>
              <p class="text-gray-900 text-sm md:text-base leading-relaxed italic mb-8">
                "Kaaru understands luxury. My blouse was the highlight of my engagement. Truly an heirloom piece!"
              </p>
            </div>
            <div>
              <p class="font-bold text-gray-900 text-sm md:text-base tracking-wide">- Aishwarya</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════
         ABOUT — Two-column editorial with image
    ════════════════════════════════════════════════ -->
    <section id="about" class="w-full overflow-hidden">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-0 items-stretch editorial-reveal">

          <!-- Image side: full photo visible -->
          <div class="relative order-2 md:order-1 bg-[#800000] flex items-center justify-center overflow-hidden">
            <img src="/assets/kaaru.jpg" alt="The Wedding Blouse by Kaaru"
              class="w-full h-auto object-contain block" />
          </div>

          <!-- Text side: warm gold background matching brand palette and screenshot -->
          <div class="bg-[#e1a730] p-10 md:p-14 lg:p-20 flex flex-col justify-center order-1 md:order-2 text-[#4A0006]">
            <span class="text-[#5A0007] text-xs tracking-[0.35em] uppercase font-bold block mb-3">ABOUT US</span>
            <h2 class="heading text-4xl md:text-5xl lg:text-6xl text-[#5A0007] font-bold mb-6">
              Our Story
            </h2>

            <p class="text-[#5A0007]/90 text-sm md:text-base leading-relaxed mb-4 font-normal">
              The Wedding Blouse – by Kaaru gives our brides a truly meaningful and complete piece of bridal artistry, making her special day even more memorable.
            </p>

            <p class="text-[#5A0007]/90 text-sm md:text-base leading-relaxed mb-6 font-normal">
              We are dedicated to creating timeless bridal blouses that embody love, tradition, and artistry, making every bride’s special day unforgettable.
            </p>

            <h3 class="text-[#5A0007] font-bold text-base md:text-lg mb-3">
              What We Do at The Wedding Blouse – by Kaaru
            </h3>

            <div class="space-y-3 mb-8 text-sm md:text-base leading-relaxed text-[#5A0007]/95">
              <p>
                <strong class="font-bold text-[#5A0007]">Personal Consultation –</strong> We sit with every bride to understand her story, style, and vision.
              </p>
              <p>
                <strong class="font-bold text-[#5A0007]">Design Detailing –</strong> Together, we create unique blouse designs with intricate elements and personal touches.
              </p>
              <p>
                <strong class="font-bold text-[#5A0007]">Perfect Stitch &amp; Style –</strong> From cut to finish, every blouse is tailored to perfection.
              </p>
              <p>
