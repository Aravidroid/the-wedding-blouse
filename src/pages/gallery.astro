---
import BaseLayout from '../layouts/BaseLayout.astro';
import { galleryData } from '../data/galleryData.js';

// Flatten data or pass cleanly to Alpine.js
const serializedGallery = JSON.stringify(galleryData);
---

<BaseLayout
  title="Our Collections - THE WEDDING BLOUSE by Kaaru"
  description="Explore our complete bridal blouse collections: Regular, Designer, Manthram, Vaibhavam, Mahotsavam, Kurti, Halfsaree, and Kids. Click any design to view its complete photo gallery.">

  <main 
    class="flex-grow py-8 md:py-12 px-4 max-w-7xl mx-auto w-full"
    x-data={`{
      data: ${serializedGallery},
      currentCategory: 'all',
      searchQuery: '',
      modalOpen: false,
      currentItem: null,
      currentSlide: 0,

      init() {
        const params = new URLSearchParams(window.location.search);
        const cat = params.get('category');
        if (cat && ['regular', 'designer', 'manthram', 'vaibhavam', 'mahotsavam', 'kurti', 'halfsaree', 'kids'].includes(cat.toLowerCase())) {
          this.currentCategory = cat.toLowerCase();
        }
        window.addEventListener('popstate', () => {
          const p = new URLSearchParams(window.location.search);
          this.currentCategory = p.get('category') || 'all';
        });
      },

      setCategory(cat) {
        this.currentCategory = cat;
        const url = new URL(window.location);
        if (cat === 'all') {
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('category', cat);
        }
        window.history.pushState({}, '', url);
      },

      get filteredItems() {
        let list = [];
        if (this.currentCategory === 'all') {
          Object.values(this.data).forEach(arr => {
            list = list.concat(arr);
          });
        } else {
          list = this.data[this.currentCategory] || [];
        }

        if (this.searchQuery.trim() !== '') {
          const q = this.searchQuery.toLowerCase();
          list = list.filter(item => 
            item.title.toLowerCase().includes(q) || 
            item.categoryName.toLowerCase().includes(q)
          );
        }
        return list;
      },

      openModal(item) {
        this.currentItem = item;
        this.currentSlide = 0;
        this.modalOpen = true;
        document.body.style.overflow = 'hidden';
      },

      closeModal() {
        this.modalOpen = false;
        document.body.style.overflow = 'auto';
      },

      nextSlide() {
        if (!this.currentItem) return;
        this.currentSlide = (this.currentSlide + 1) % this.currentItem.images.length;
      },

      prevSlide() {
        if (!this.currentItem) return;
        this.currentSlide = (this.currentSlide - 1 + this.currentItem.images.length) % this.currentItem.images.length;
      }
    }`}>

    <!-- Header & Category Pills -->
    <div class="text-center mb-8">
      <span class="text-brand-gold font-semibold text-sm tracking-widest uppercase">Handcrafted Masterpieces</span>
      <h1 class="text-3xl md:text-5xl heading brand-maroon font-bold mt-2 mb-3">Our Collections</h1>
      <p class="text-gray-600 max-w-2xl mx-auto text-sm md:text-base">
        Click any design to view its complete photo collection and details.
      </p>

      <!-- Category Filter Pills with Alpine -->
      <div class="flex flex-wrap justify-center gap-2 md:gap-3 mt-6">
        <button 
          @click="setCategory('all')" 
          :class="currentCategory === 'all' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          All Collections
        </button>
        <button 
          @click="setCategory('regular')" 
          :class="currentCategory === 'regular' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          Regular
        </button>
        <button 
          @click="setCategory('designer')" 
          :class="currentCategory === 'designer' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          Designer
        </button>
        <button 
          @click="setCategory('manthram')" 
          :class="currentCategory === 'manthram' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          Manthram
        </button>
        <button 
          @click="setCategory('vaibhavam')" 
          :class="currentCategory === 'vaibhavam' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          Vaibhavam
        </button>
        <button 
          @click="setCategory('mahotsavam')" 
          :class="currentCategory === 'mahotsavam' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          Mahotsavam
        </button>
        <button 
          @click="setCategory('kurti')" 
          :class="currentCategory === 'kurti' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          Kurti
        </button>
        <button 
          @click="setCategory('halfsaree')" 
          :class="currentCategory === 'halfsaree' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          Halfsaree
        </button>
        <button 
          @click="setCategory('kids')" 
          :class="currentCategory === 'kids' ? 'active-pill shadow-md' : 'bg-white text-gray-700 border-brand-maroon/20 hover:border-brand-maroon'"
          class="px-5 py-2.5 rounded-full text-xs md:text-sm font-semibold border transition shadow-sm">
          Kids
        </button>
      </div>
    </div>



    <!-- Catalog Items Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      <template x-for="item in filteredItems" :key="item.id">
        <div 
          @click="openModal(item)"
          class="catalog-card bg-white rounded-2xl overflow-hidden shadow-premium hover:shadow-2xl transition-all duration-300 cursor-pointer flex flex-col group border border-amber-100/60 transform hover:-translate-y-1">
          <!-- Card Image Thumbnail -->
          <div class="relative h-72 sm:h-80 w-full overflow-hidden bg-gray-100">
            <img 
              :src="'/' + item.images[0]" 
              :alt="item.title"
              loading="lazy" 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
              <span class="text-white text-xs font-medium flex items-center space-x-1.5 bg-black/40 px-3 py-1.5 rounded-full backdrop-blur-sm">
                <i class="fas fa-search-plus"></i>
                <span>View <span x-text="item.images.length"></span> Photos</span>
              </span>
            </div>
            <!-- Category Badge -->
            <span 
              x-text="item.categoryName" 
              class="absolute top-3 left-3 bg-brand-maroon/90 text-white text-[11px] font-semibold uppercase px-3 py-1 rounded-full backdrop-blur-sm tracking-wider">
            </span>
          </div>

          <!-- Card Content -->
          <div class="p-5 flex flex-col justify-between flex-grow">
            <div>
              <h3 x-text="item.title" class="heading text-xl font-bold brand-maroon group-hover:text-amber-700 transition"></h3>
              <p class="text-gray-500 text-xs mt-1">Exclusive Handcrafted Bridal Blouse</p>
            </div>
            <div class="mt-4 pt-3 border-t border-gray-100 flex items-center justify-between text-xs text-brand-maroon font-semibold">
              <span class="flex items-center space-x-1">
                <i class="fas fa-camera text-gray-400"></i>
                <span x-text="item.images.length + ' Angles'"></span>
              </span>
              <span class="group-hover:translate-x-1 transition-transform inline-flex items-center">
                Explore <i class="fas fa-arrow-right ml-1 text-[10px]"></i>
              </span>
            </div>
          </div>
        </div>
      </template>
    </div>

    <!-- Empty State -->
    <div x-show="filteredItems.length === 0" x-cloak class="text-center py-16">
      <i class="fas fa-gem text-5xl brand-gold mb-4 opacity-40"></i>
      <h3 class="text-xl font-bold brand-maroon">No designs match your criteria</h3>
      <p class="text-gray-600 mt-1 text-sm">Try resetting filters or searching for something else.</p>
      <button 
        @click="currentCategory = 'all'; searchQuery = ''" 
        class="mt-4 px-4 py-2 bg-brand-maroon text-white text-xs font-semibold rounded-full hover:bg-red-900 transition">
        Reset Filters
      </button>
    </div>

    <!-- Alpine.js Multi-Image Modal Lightbox -->
    <div 
      x-show="modalOpen" 
      x-cloak 
      @keydown.escape.window="closeModal()"
      @keydown.arrow-left.window="prevSlide()"
      @keydown.arrow-right.window="nextSlide()"
      x-transition:enter="transition ease-out duration-300"
      x-transition:enter-start="opacity-0"
      x-transition:enter-end="opacity-100"
      x-transition:leave="transition ease-in duration-200"
      x-transition:leave-start="opacity-100"
      x-transition:leave-end="opacity-0"
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/85 p-3 md:p-6 backdrop-blur-sm">

      <div 
        @click.away="closeModal()"
        class="relative max-w-5xl w-full bg-white rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row max-h-[92vh]">

        <!-- Close Button -->
        <button 
          @click="closeModal()"
          class="absolute top-3 right-3 text-white hover:text-brand-gold text-2xl z-50 bg-black/60 w-10 h-10 rounded-full flex items-center justify-center transition"
          aria-label="Close modal">
          <i class="fas fa-times"></i>
        </button>

        <!-- Slider Container -->
        <div class="w-full md:w-2/3 relative bg-neutral-950 flex items-center justify-center min-h-[360px] md:h-[600px] overflow-hidden group">
          <!-- Counter Badge -->
          <div class="absolute top-4 left-4 z-20 bg-black/60 text-white text-xs font-semibold px-3 py-1 rounded-full flex items-center space-x-1.5 backdrop-blur-sm">
            <i class="fas fa-images text-xs"></i>
            <span x-text="(currentSlide + 1) + ' / ' + (currentItem ? currentItem.images.length : 1)"></span>
          </div>

          <!-- Active Image -->
          <template x-if="currentItem">
            <div class="w-full h-full flex items-center justify-center p-2">
              <img 
                :src="'/' + currentItem.images[currentSlide]" 
                :alt="currentItem.title"
                class="max-w-full max-h-full object-contain transition-all duration-300 select-none" />
            </div>
          </template>

          <!-- Nav Arrows -->
          <button 
            x-show="currentItem && currentItem.images.length > 1"
            @click="prevSlide()"
            class="absolute left-3 bg-black/45 hover:bg-black/75 text-white w-11 h-11 rounded-full flex items-center justify-center transition z-20"
            aria-label="Previous image">
            <i class="fas fa-chevron-left text-lg"></i>
          </button>
          <button 
            x-show="currentItem && currentItem.images.length > 1"
            @click="nextSlide()"
            class="absolute right-3 bg-black/45 hover:bg-black/75 text-white w-11 h-11 rounded-full flex items-center justify-center transition z-20"
            aria-label="Next image">
            <i class="fas fa-chevron-right text-lg"></i>
          </button>

          <!-- Slide Dots Indicator -->
          <div 
            x-show="currentItem && currentItem.images.length > 1"
            class="absolute bottom-4 left-0 right-0 z-20 flex justify-center space-x-1.5">
            <template x-for="(_, idx) in currentItem ? currentItem.images : []" :key="idx">
              <button 
                @click="currentSlide = idx" 
                :class="idx === currentSlide ? 'bg-brand-gold w-6' : 'bg-white/60 w-2'"
                class="h-2 rounded-full transition-all duration-300 focus:outline-none"
                :aria-label="'Go to slide ' + (idx + 1)">
              </button>
            </template>
          </div>
        </div>

        <!-- Details Panel -->
        <div class="w-full md:w-1/3 p-6 flex flex-col justify-between bg-white text-gray-900 overflow-y-auto">
          <div>
            <span x-text="currentItem ? currentItem.categoryName : ''" class="text-xs font-bold text-brand-gold uppercase tracking-wider"></span>
            <h3 x-text="currentItem ? currentItem.title : ''" class="heading text-2xl font-bold brand-maroon mt-1 mb-2"></h3>
            <p class="text-gray-600 text-sm mb-4 leading-relaxed">
              Handcrafted with exquisite artistry and custom tailoring. Click arrows or swipe to explore all angles.
            </p>
            <div class="bg-amber-50/70 p-3 rounded-xl border border-amber-200/50 mb-6 text-xs text-amber-900 space-y-1">
              <p><i class="fas fa-check text-green-600 mr-1.5"></i> Custom embroidery and maggam work</p>
              <p><i class="fas fa-check text-green-600 mr-1.5"></i> Available in bespoke bridal measurements</p>
              <p><i class="fas fa-check text-green-600 mr-1.5"></i> Delivery available across India</p>
            </div>
          </div>

          <div class="space-y-3 pt-4 border-t border-gray-100">
            <a 
              :href="'https://wa.me/919629210802?text=' + encodeURIComponent('Hi Kaaru! I am interested in ' + (currentItem ? currentItem.title : 'this design') + ' (' + (currentItem ? currentItem.categoryName : '') + '). Can you share pricing and consultation details?')" 
              target="_blank" 
              class="w-full py-3 bg-green-500 hover:bg-green-600 text-white text-sm font-semibold rounded-lg flex items-center justify-center space-x-2 transition shadow-md">
              <i class="fab fa-whatsapp text-lg"></i>
              <span>Enquire on WhatsApp</span>
            </a>
            <a 
              href="https://www.instagram.com/the.wedding.blouse/" 
              target="_blank" 
              rel="noopener noreferrer"
              class="w-full py-2.5 border border-pink-500 text-pink-600 hover:bg-pink-50 text-xs font-semibold rounded-lg flex items-center justify-center space-x-2 transition">
              <i class="fab fa-instagram text-sm"></i>
              <span>View on Instagram</span>
            </a>
          </div>
        </div>

      </div>
    </div>
  </main>
</BaseLayout>
