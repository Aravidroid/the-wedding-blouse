---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "THE WEDDING BLOUSE by Kaaru - Premium Bridal Designs",
  description = "Every marriage begins with trust. Every bride begins with us. Handcrafted bridal blouse couture, maggam work, and bespoke tailoring."
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" type="image/png" href="/assets/logo_transparent.png" />
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
  <style>
    [x-cloak] { display: none !important; }
    .active-pill {
      background-color: #7A1C30 !important;
      color: #FFFFFF !important;
      border-color: #7A1C30 !important;
    }
  </style>
</head>

<body class="bg-brand-cream scroll-smooth min-h-screen flex flex-col justify-between">
  <!-- Navbar with Alpine.js Mobile & Dropdown State -->
  <nav class="sticky top-0 z-40 bg-white shadow-premium" x-data="{ mobileOpen: false, catDropdown: false }">
    <div class="max-w-7xl mx-auto px-4 py-4 flex items-center justify-between md:py-6">
      <a href="/" class="flex items-center space-x-2">
        <div class="text-lg md:text-2xl heading brand-maroon font-bold">
          The Wedding Blouse by Kaaru
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class="nav-link text-gray-700 font-medium text-sm hover:text-brand-maroon transition">Home</a>

        <div class="relative" @mouseleave="catDropdown = false">
          <button 
            type="button"
            @mouseenter="catDropdown = true"
            @click="catDropdown = !catDropdown"
            class="nav-link text-gray-700 font-medium text-sm flex items-center space-x-1 hover:text-brand-maroon transition">
            <span>Categories</span>
            <i class="fas fa-chevron-down text-xs transition-transform duration-300" :class="catDropdown ? 'rotate-180' : ''"></i>
          </button>

          <!-- Dropdown Menu -->
          <div 
            x-show="catDropdown" 
            x-cloak
            @click.outside="catDropdown = false"
            x-transition:enter="transition ease-out duration-200"
            x-transition:enter-start="opacity-0 translate-y-1"
            x-transition:enter-end="opacity-100 translate-y-0"
            x-transition:leave="transition ease-in duration-150"
            x-transition:leave-start="opacity-100 translate-y-0"
            x-transition:leave-end="opacity-0 translate-y-1"
            class="absolute left-0 mt-2 w-52 bg-white shadow-premium rounded-lg py-2 z-50 border border-amber-100/60">
            <a href="/gallery?category=regular" class="dropdown-item block px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50">Regular</a>
            <a href="/gallery?category=designer" class="dropdown-item block px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50">Designer</a>
            <a href="/gallery?category=manthram" class="dropdown-item block px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50">Manthram</a>
            <a href="/gallery?category=vaibhavam" class="dropdown-item block px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50">Vaibhavam</a>
            <a href="/gallery?category=mahotsavam" class="dropdown-item block px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50">Mahotsavam</a>
            <a href="/gallery?category=kurti" class="dropdown-item block px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50">Kurti</a>
            <a href="/gallery?category=halfsaree" class="dropdown-item block px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50">Halfsaree</a>
            <a href="/gallery?category=kids" class="dropdown-item block px-4 py-2.5 text-sm text-gray-700 hover:bg-amber-50">Kids</a>
          </div>
        </div>

        <a href="/#about" class="nav-link text-gray-700 font-medium text-sm hover:text-brand-maroon transition">About Us</a>
        <a href="/#contact" class="nav-link text-gray-700 font-medium text-sm hover:text-brand-maroon transition">Get in Touch</a>
        <a href="/gallery" class="px-4 py-2 bg-brand-maroon text-white text-xs font-semibold uppercase tracking-wider rounded-full hover:bg-red-900 transition shadow-sm">
          Browse Gallery
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <button 
        id="mobileMenuBtn" 
        @click="mobileOpen = !mobileOpen" 
        class="md:hidden text-gray-700 text-xl p-2 focus:outline-none"
        aria-label="Toggle Navigation">
        <i class="fas" :class="mobileOpen ? 'fa-times' : 'fa-bars'"></i>
      </button>
    </div>

    <!-- Mobile Drawer Menu -->
    <div 
      x-show="mobileOpen" 
      x-cloak 
      x-transition 
      class="md:hidden bg-white px-4 py-3 border-t border-gray-100 space-y-2 shadow-lg">
      <a href="/" class="block py-2 text-gray-700 font-medium" @click="mobileOpen = false">Home</a>
      <div class="py-2 text-gray-700 font-bold brand-maroon">Categories:</div>
      <a href="/gallery?category=regular" class="block pl-4 py-1 text-gray-600 hover:text-brand-maroon" @click="mobileOpen = false">Regular</a>
      <a href="/gallery?category=designer" class="block pl-4 py-1 text-gray-600 hover:text-brand-maroon" @click="mobileOpen = false">Designer</a>
      <a href="/gallery?category=manthram" class="block pl-4 py-1 text-gray-600 hover:text-brand-maroon" @click="mobileOpen = false">Manthram</a>
      <a href="/gallery?category=vaibhavam" class="block pl-4 py-1 text-gray-600 hover:text-brand-maroon" @click="mobileOpen = false">Vaibhavam</a>
      <a href="/gallery?category=mahotsavam" class="block pl-4 py-1 text-gray-600 hover:text-brand-maroon" @click="mobileOpen = false">Mahotsavam</a>
      <a href="/gallery?category=kurti" class="block pl-4 py-1 text-gray-600 hover:text-brand-maroon" @click="mobileOpen = false">Kurti</a>
      <a href="/gallery?category=halfsaree" class="block pl-4 py-1 text-gray-600 hover:text-brand-maroon" @click="mobileOpen = false">Halfsaree</a>
      <a href="/gallery?category=kids" class="block pl-4 py-1 text-gray-600 hover:text-brand-maroon" @click="mobileOpen = false">Kids</a>
      <a href="/#about" class="block py-2 text-gray-700 font-medium" @click="mobileOpen = false">About Us</a>
      <a href="/#contact" class="block py-2 text-gray-700 font-medium" @click="mobileOpen = false">Get in Touch</a>
      <a href="/gallery" class="block text-center mt-3 py-2.5 bg-brand-maroon text-white font-medium rounded-lg" @click="mobileOpen = false">
        View Entire Gallery
      </a>
    </div>
  </nav>

  <!-- Page Content Slot -->
  <slot />

  <!-- Sticky WhatsApp Quick Action Button -->
  <a 
    href="https://wa.me/919629210802?text=Hi%20Kaaru!%20I'm%20interested%20in%20your%20bridal%20blouse%20collection." 
    target="_blank" 
    class="sticky-whatsapp" 
    aria-label="Chat with us on WhatsApp">
    <button class="bg-green-500 text-white rounded-full p-4 shadow-lg hover:bg-green-600 transition flex items-center space-x-2">
      <i class="fab fa-whatsapp text-2xl"></i>
      <span class="hidden md:inline font-semibold">Chat with us</span>
    </button>
  </a>

  <!-- Mobile Bottom Quick Navigation Bar -->
  <div class="bottom-nav md:hidden">
    <a href="/" class="nav-item">
      <i class="fas fa-home"></i>
      <span>Home</span>
    </a>
    <a href="/gallery" class="nav-item">
      <i class="fas fa-th"></i>
      <span>Designs</span>
    </a>
    <a href="/#contact" class="nav-item">
      <i class="fas fa-envelope"></i>
      <span>Contact</span>
    </a>
  </div>

  <!-- Reusable Global Footer -->
  <footer class="bg-brand-maroon text-white py-10 px-4 mt-auto">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="text-center md:text-left">
        <h4 class="heading text-xl font-bold tracking-wide">The Wedding Blouse by Kaaru</h4>
        <p class="text-xs text-gray-300 mt-1">Every marriage begins with trust. Every bride begins with us.</p>
      </div>
      <div class="flex space-x-6 text-xl">
        <a href="https://www.instagram.com/the.wedding.blouse/" target="_blank" rel="noopener noreferrer" class="hover:text-brand-gold transition" aria-label="Instagram">
          <i class="fab fa-instagram"></i>
        </a>
        <a href="https://wa.me/919629210802" target="_blank" class="hover:text-brand-gold transition" aria-label="WhatsApp">
          <i class="fab fa-whatsapp"></i>
        </a>
        <a href="tel:+919629210802" class="hover:text-brand-gold transition" aria-label="Phone">
          <i class="fas fa-phone"></i>
        </a>
      </div>
      <div class="border-t border-brand-gold/30 md:border-t-0 pt-4 md:pt-0 text-center text-xs text-gray-300">
        © 2026 - The Wedding Blouse. All rights reserved.
      </div>
    </div>
  </footer>
</body>
</html>
